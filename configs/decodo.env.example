# Installed on the gateway VM as /etc/proxygw.env, mode 600 (root-readable only -
# it holds a plaintext password).
#
# Format: socks5://<username>:<password>@<host>:<port>
# Get these values from your proxy provider's dashboard.
PROXY=socks5://CHANGE_ME_USER:CHANGE_ME_PASS@CHANGE_ME_HOST:CHANGE_ME_PORT
